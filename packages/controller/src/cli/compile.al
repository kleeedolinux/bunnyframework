# bunny compile: templates/**/*.html.eal -> src/_eal/*.al + registry.al (EalViews.install).
module BunnyCli
  module Compile
    def self.run(app : String) : Int32
      tdir = System.IO.Path.Combine(app, "templates")
      out_dir = System.IO.Path.Combine(app, "src", "_eal")
      if System.IO.Directory.Exists(out_dir)
        for f in System.IO.Directory.GetFiles(out_dir, "*.al")
          System.IO.File.Delete(f)
        end
      else
        System.IO.Directory.CreateDirectory(out_dir)
      end
      names = List(String).new
      if System.IO.Directory.Exists(tdir)
        files = System.IO.Directory.GetFiles(tdir, "*" + Bunny::Eal::EXT, System.IO.SearchOption.AllDirectories)
        System.Array.Sort(files)
        for file in files
          name = Bunny::Eal.template_name(tdir, file)
          src = Bunny::Eal.compile(name, System.IO.File.ReadAllText(file))
          cls = Bunny::Eal.class_name(name)
          System.IO.File.WriteAllText(System.IO.Path.Combine(out_dir, Names.snake(cls) + ".al"), src)
          names << cls
        end
      end
      sb = System.Text.StringBuilder.new
      sb.Append("# Generated by `bunny compile`. Do not edit.\nmodule EalViews\n  def self.install : Nil\n")
      for cls in names
        sb.Append("    Bunny::Views.register(#{cls}.new)\n")
      end
      sb.Append("  end\nend\n")
      System.IO.File.WriteAllText(System.IO.Path.Combine(out_dir, "registry.al"), sb.ToString)
      names.size
    end
  end
end
